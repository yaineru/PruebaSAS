NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SECRET_KEY=server-only-secret-key

# Base URL of this deployment (no trailing slash). Used to build the Google
# OAuth redirect_uri - must match a URI configured in the Google Cloud console.
APP_URL=http://localhost:3000

# Required for a company to configure its own SMTP server under
# Configuración > Correo (lib/email/smtp-crypto.ts) - any non-empty
# passphrase, used to derive the AES-256 key that encrypts each company's
# stored SMTP password. Without it, the SMTP settings form refuses to save
# a password (clear error shown, nothing fails silently).
SMTP_CREDENTIALS_ENCRYPTION_KEY=

# Optional, instance-wide fallback only: used when a company has NOT
# configured its own SMTP (lib/email/resend.ts). Without either this or a
# company's own SMTP, emails are queued to email_log as FAILED and in-app
# notifications still work normally - email is never a hard dependency.
RESEND_API_KEY=
RESEND_FROM_EMAIL=EmpresaOS <notificaciones@tudominio.com>

# Optional: enables Google Calendar sync (per-user OAuth, lib/google/*).
# Without these, the Agenda module works fully; the "Conectar Google
# Calendar" button just stays hidden. Create an OAuth Client (Web
# application) in Google Cloud Console with a redirect URI of
# "${APP_URL}/api/google/callback" and paste its credentials here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any non-empty passphrase - used to derive the AES-256 key that encrypts
# stored Google refresh/access tokens (lib/google/token-crypto.ts).
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Required in production (Vercel). Protects app/api/cron/reminders - Vercel
# Cron (see vercel.json) sends this as "Authorization: Bearer <value>"
# automatically once it's set as a project env var. Without it the reminder
# dispatch endpoint would be callable by anyone with the URL. Any random
# secret string works; without this var set the route allows unauthenticated
# calls (fine for local dev only).
# NOTE: Vercel's Hobby plan only runs Cron Jobs once per day, not per-minute -
# reminders will be delayed up to 24h on that plan. Per-minute schedules
# require a Pro (or higher) plan, or an external pinger (e.g. a GitHub
# Actions scheduled workflow, or cron-job.org) hitting this same endpoint.
CRON_SECRET=
